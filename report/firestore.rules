rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function myEmail() {
      return request.auth.token.email.lower();
    }
    // בעלי האתר - תמיד מנהלים (חייב להתאים ל-OWNER_EMAILS ב-config.js)
    function isOwner() {
      return request.auth != null && myEmail() in [
        'noam0600@gmail.com'
      ];
    }
    // מנהלים נוספים נשמרים באוסף admins, ומנהל קיים יכול להוסיף ולהסיר מאתר המנהל
    function isAdmin() {
      return isOwner() || (request.auth != null && exists(/databases/$(database)/documents/admins/$(myEmail())));
    }
    match /reports/{id} {
      // כל מי שיש לו את הקישור לטופס יכול לשלוח דוח, אבל לא לקרוא דוחות של אחרים
      allow create: if request.resource.data.keys().hasAll(['date', 'time', 'vehicle', 'giver', 'receiver', 'checks', 'createdAt'])
                    && request.resource.data.vehicle is string && request.resource.data.vehicle.size() < 40;
      allow read, delete: if isAdmin();
      allow update: if false;
    }
    match /admins/{email} {
      allow read: if isAdmin();
      allow create: if isAdmin() && email == email.lower() && request.resource.data.keys().hasOnly(['addedBy', 'addedAt']);
      allow delete: if isAdmin() && email != myEmail();
      allow update: if false;
    }
  }
}
