rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function myEmail() {
      return request.auth.token.email.lower();
    }
    // בעלי האתר - תמיד מנהלים (חייב להתאים ל-OWNER_EMAILS ב-config.js)
    function isOwner() {
      return request.auth != null && myEmail() in [
        'noam0600@gmail.com'
      ];
    }
    // מנהלים נוספים נשמרים באוסף admins, ומנהל קיים יכול להוסיף ולהסיר מאתר המנהל
    function isAdmin() {
      return isOwner() || (request.auth != null && exists(/databases/$(database)/documents/admins/$(myEmail())));
    }
    match /reports/{id} {
      // כל מי שיש לו את הקישור לטופס יכול לשלוח דוח, אבל לא לקרוא דוחות של אחרים
      allow create: if request.resource.data.keys().hasAll(['date', 'time', 'vehicle', 'giver', 'receiver', 'checks', 'createdAt'])
                    && request.resource.data.vehicle is string && request.resource.data.vehicle.size() < 40;
      allow read, delete: if isAdmin();
      allow update: if false;
    }
    // רשימת הרכבים לטופס: כולם קוראים, רק מנהל משנה
    match /settings/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }
    // הליקויים הפתוחים של כל רכב - רק שם הסעיף ותאריך. הטופס יכול רק להוסיף; רק מנהל מוחק
    match /openByVehicle/{key} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['items']);
      allow update: if isAdmin() || (request.resource.data.keys().hasOnly(['items'])
                    && request.resource.data.items.keys().hasAll(resource.data.items.keys()));
      allow delete: if isAdmin();
    }
    // ליקוי: נפתח מהטופס, ורק מנהל רואה ומסמן "תוקן"
    match /issues/{id} {
      allow create: if request.resource.data.status == 'open'
                    && request.resource.data.keys().hasOnly(['vehicleKey', 'vehicle', 'item', 'itemText', 'status', 'openedAt', 'reportId', 'giver', 'receiver']);
      allow read, update, delete: if isAdmin();
    }
    // תמונות ליקויים: הטופס שולח, רק מנהל רואה
    match /photos/{id} {
      allow create: if request.resource.data.keys().hasOnly(['reportId', 'item', 'data', 'createdAt'])
                    && request.resource.data.data is string && request.resource.data.data.size() < 900000;
      allow read, delete: if isAdmin();
    }
    match /admins/{email} {
      allow read: if isAdmin();
      allow create: if isAdmin() && email == email.lower() && request.resource.data.keys().hasOnly(['addedBy', 'addedAt']);
      allow delete: if isAdmin() && email != myEmail();
      allow update: if false;
    }
  }
}
